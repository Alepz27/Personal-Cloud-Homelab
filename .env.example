# Sanitized documentation example only.
# Copy to .env locally and replace placeholders. Never commit the real .env.

# Pin images to versions compatible with the chosen Immich release.
IMMICH_SERVER_IMAGE=ghcr.io/immich-app/immich-server:<PINNED_VERSION>
IMMICH_MACHINE_LEARNING_IMAGE=ghcr.io/immich-app/immich-machine-learning:<PINNED_VERSION>
POSTGRES_IMAGE=<COMPATIBLE_POSTGRES_IMAGE_AND_TAG>
REDIS_IMAGE=<COMPATIBLE_REDIS_IMAGE_AND_TAG>

# Use private, explicit host paths. Do not publish personal folder names.
UPLOAD_LOCATION=<ABSOLUTE_HOST_MEDIA_PATH>
DB_DATA_LOCATION=<ABSOLUTE_HOST_DATABASE_PATH>
MODEL_CACHE_LOCATION=<ABSOLUTE_HOST_MODEL_CACHE_PATH>

DB_USERNAME=<DATABASE_USERNAME>
DB_PASSWORD=<LONG_RANDOM_DATABASE_PASSWORD>
DB_DATABASE_NAME=<DATABASE_NAME>

# Optional local-only port mapping used by the example Compose file.
IMMICH_HTTP_PORT=2283
